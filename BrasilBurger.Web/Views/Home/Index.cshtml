@{
    ViewData["Title"] = "Brasil Burger";
}

<div class="catalogue-hero text-center py-5 bg-light">
  <h2 class="display-6 fw-bold">Notre Catalogue</h2>
  <p class="text-muted mb-4">Découvrez notre sélection de burgers gourmands et de menus complets</p>
  <div class="container-sm">
    <div class="search-filter">
      <div class="input-group mb-3 shadow-sm rounded-pill overflow-hidden">
        <span class="input-group-text bg-white border-0">🔍</span>
        <input class="form-control border-0" id="searchInput" type="search" placeholder="Rechercher un burger ou menu..." aria-label="Recherche" />
      </div>
      <div class="btn-group btn-group-toggle rounded-pill bg-white p-2 shadow-sm" role="group" aria-label="Filtres">
        <button class="btn btn-sm btn-filter active" data-filter="all">Tout</button>
        <button class="btn btn-sm btn-filter" data-filter="burgers">Burgers</button>
        <button class="btn btn-sm btn-filter" data-filter="menus">Menus</button>
      </div>
    </div>
  </div>
</div>

<div class="container my-5">
  <div id="productsList" class="row gy-4">
    @if (ViewBag.Burgers != null && ViewBag.Burgers.Count > 0)
    {
      @foreach(var burger in ViewBag.Burgers)
      {
        <div class="col-12 col-md-6">
          <div class="card product-card overflow-hidden rounded-3 border-0 shadow-sm">
            <img src="@burger.ImageUrl" class="card-img-top product-image" alt="@burger.Name" />
            <div class="card-body">
              <h5 class="card-title">@burger.Name</h5>
              <p class="card-text text-muted small">@burger.Description</p>
              <div class="d-flex align-items-center justify-content-between mt-3">
                <div class="price fw-bold text-orange">@String.Format("{0:N0}", burger.Price) FCFA</div>
                <button class="btn btn-add btn-sm">+ Ajouter</button>
              </div>
            </div>
          </div>
        </div>
      }
    }
    else
    {
      <div class="col-12">
        <p class="text-muted">Aucun produit trouvé.</p>
      </div>
    }
  </div>
</div>

@section Scripts {
<script>
  (function(){
    const searchInput = document.getElementById('searchInput');
    const cols = document.querySelectorAll('#productsList .col-12');
    const cards = document.querySelectorAll('.product-card');
    searchInput?.addEventListener('input', function(e){
      const q = e.target.value.toLowerCase();
      cols.forEach(col => {
        const title = col.querySelector('.card-title')?.textContent.toLowerCase() || '';
        const desc = col.querySelector('.card-text')?.textContent.toLowerCase() || '';
        const visible = (!q) || title.includes(q) || desc.includes(q);
        col.hidden = !visible;
      });
    });

    document.querySelectorAll('.btn-filter').forEach(btn=>{
      btn.addEventListener('click', function(){
        document.querySelectorAll('.btn-filter').forEach(b=>b.classList.remove('active'));
        this.classList.add('active');
        const f = this.dataset.filter;
        cols.forEach(col=>{
          if(f==='all'){ col.hidden = false; return; }
          if(f==='burgers'){ col.hidden = !col.querySelector('.product-card').classList.contains('burger'); return; }
          if(f==='menus'){ col.hidden = !col.querySelector('.product-card').classList.contains('menu'); return; }
        });
      });
    });
    // mark all product cards as burger for now
    cards.forEach(c=>c.classList.add('burger'));
  })();
</script>
} 