@model List<BrasilBurger.Web.Models.Order>
@{
    ViewData["Title"] = "Mes commandes";
}
<div class="container my-5">
  <h2 class="fw-bold mb-4">Mes commandes</h2>
  @if (!Model.Any())
  {
    <div class="alert alert-info">Vous n'avez encore aucune commande. Passez votre première commande !</div>
  }
  else
  {
    <div class="list-group">
      @foreach(var o in Model)
      {
        <div class="list-group-item d-flex justify-content-between align-items-start">
          <div>
            <div class="fw-bold">Commande #@o.Id</div>
            <div class="text-muted small">@o.OrderDate.ToString("g") — <span class="badge bg-secondary">@o.Status</span></div>
          </div>
          <div class="text-end">
            <div class="fw-bold">@String.Format("{0:N0}", o.TotalAmount) FCFA</div>
            <a class="btn btn-sm btn-outline-primary mt-2" href="#">Détails</a>
          </div>
        </div>
      }
    </div>
  }
</div>
