@model List<BrasilBurger.Web.Models.CartItem>
@{
    ViewData["Title"] = "Panier";
}

<h2>Panier</h2>
@if (!Model.Any())
{
    <p class="text-muted">Votre panier est vide.</p>
}
else
{
    <table class="table">
        <thead>
            <tr><th>Produit</th><th>Prix unitaire</th><th>Quantité</th><th>Sous-total</th><th></th></tr>
        </thead>
        <tbody>
            @foreach(var item in Model)
            {
                <tr>
                    <td>
                        <img src="@item.ImageUrl" style="width:64px;height:64px;object-fit:cover" class="me-2" />
                        <strong>@item.Name</strong>
                    </td>
                    <td>@String.Format("{0:N0}", item.UnitPrice) FCFA</td>
                    <td>
                        <form asp-action="UpdateQuantity" method="post" class="d-inline">
                            <input type="hidden" name="productId" value="@item.ProductId" />
                            <input type="hidden" name="productType" value="@item.ProductType" />
                            <input type="number" name="qty" value="@item.Quantity" min="1" class="form-control d-inline" style="width:80px" />
                            <button class="btn btn-sm btn-outline-secondary ms-2">Mettre</button>
                        </form>
                    </td>
                    <td>@String.Format("{0:N0}", item.SubTotal) FCFA</td>
                    <td>
                        <form asp-action="Remove" method="post">
                            <input type="hidden" name="productId" value="@item.ProductId" />
                            <input type="hidden" name="productType" value="@item.ProductType" />
                            <button class="btn btn-danger btn-sm">Supprimer</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>

    <div class="d-flex justify-content-between align-items-center">
        <div>
            <strong>Total:</strong> <span class="fs-5 text-orange">@String.Format("{0:N0}", ViewBag.Total) FCFA</span>
        </div>
        <div>
            <a asp-action="Checkout" class="btn btn-primary">Passer à la commande</a>
        </div>
    </div>
}
