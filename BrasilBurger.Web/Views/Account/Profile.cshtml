@model BrasilBurger.Web.Models.Client
@{
    ViewData["Title"] = "Mon profil";
}
<div class="container my-5">
  <h2 class="fw-bold mb-3">Mon profil</h2>
  <div class="card p-4 shadow-sm">
    <div><strong>Nom :</strong> @Model.FirstName @Model.LastName</div>
    <div><strong>Email :</strong> @Model.Email</div>
    <div><strong>Téléphone :</strong> @Model.Phone</div>
    <div class="mt-3">
      <a class="btn btn-outline-primary" asp-controller="Account" asp-action="Register">Modifier</a>
    </div>
  </div>
</div>
